# Copy this file to .env and fill in the passwords. Never commit .env.
MYSQL_DATABASE=adventurexp
MYSQL_USER=adventurexp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Only used by compose.yaml (local build)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/adventurexp
SPRING_DATASOURCE_USERNAME=adventurexp

# Must be the same as MYSQL_PASSWORD
SPRING_DATASOURCE_PASSWORD=
